# gndigest 환경변수 (docs/01-architecture.md §3, ARCH-S1)
# 복사해서 쓴다: cp .env.example .env   (.env는 git에 올라가지 않는다)
# 로컬 실행: uv run --env-file .env gndigest report --dry-run
# 운영(GitHub Actions)에서는 같은 이름을 GitHub Secrets에 등록한다.

# 비밀값
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DISCORD_BOT_TOKEN=

# 설정
DISCORD_REPORT_CHANNEL_ID=
DISCORD_FEEDBACK_CHANNEL_ID=
DISCORD_OWNER_USER_ID=
# 무료 티어 Flash 모델 이름 (OPEN-2, T05에서 확인)
GEMINI_MODEL=
# 비워 두면 typesafe/jev-1.13 (JEV-C2: 버전 고정)
JEV_MODEL=
